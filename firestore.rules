rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stock: everyone can read (needed to show "Habis" badges to every
    // visitor), but only an authenticated admin session can change it.
    // No customer PII here, so open read/list is fine.
    match /lighture_stock/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: contain customer_name, phone_number, delivery address/lat/lng
    // - the most sensitive data in this app. Anyone can CREATE one (guest
    // checkout), but reading (get OR list), updating, or deleting requires
    // admin login. This is the main thing keeping customer PII private.
    match /lighture_orders/{orderId} {
      allow read, update, delete: if request.auth != null;

      allow create: if
        request.resource.data.record_type == 'order' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.payment_method in ['qris', 'cash'] &&
        request.resource.data.customer_name is string &&
        request.resource.data.customer_name.size() > 0 &&
        request.resource.data.customer_name.size() <= 100 &&
        request.resource.data.phone_number is string &&
        request.resource.data.phone_number.size() > 0 &&
        request.resource.data.phone_number.size() <= 20 &&
        request.resource.data.items_ordered is string &&
        request.resource.data.items_ordered.size() <= 500 &&
        request.resource.data.total_price is number &&
        request.resource.data.total_price >= 0 &&
        request.resource.data.total_price <= 5000000 &&
        (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500)) &&
        (!('payment_proof_data' in request.resource.data) || (request.resource.data.payment_proof_data is string && request.resource.data.payment_proof_data.size() <= 400000)) &&
        (!('member_phone' in request.resource.data) || (request.resource.data.member_phone is string && request.resource.data.member_phone.size() <= 20)) &&
        (!('voucher_code' in request.resource.data) || (request.resource.data.voucher_code is string && request.resource.data.voucher_code.size() <= 20)) &&
        (!('points_awarded' in request.resource.data) || request.resource.data.points_awarded == false) &&
        (!('delivery_address' in request.resource.data) || (request.resource.data.delivery_address is string && request.resource.data.delivery_address.size() <= 300)) &&
        (!('delivery_lat' in request.resource.data) || request.resource.data.delivery_lat == null || (request.resource.data.delivery_lat is number && request.resource.data.delivery_lat >= -90 && request.resource.data.delivery_lat <= 90)) &&
        (!('delivery_lng' in request.resource.data) || request.resource.data.delivery_lng == null || (request.resource.data.delivery_lng is number && request.resource.data.delivery_lng >= -180 && request.resource.data.delivery_lng <= 180)) &&
        (!('delivery_distance_km' in request.resource.data) || request.resource.data.delivery_distance_km == null || (request.resource.data.delivery_distance_km is number && request.resource.data.delivery_distance_km >= 0 && request.resource.data.delivery_distance_km <= 200)) &&
        (!('delivery_distance_is_estimate' in request.resource.data) || request.resource.data.delivery_distance_is_estimate == null || request.resource.data.delivery_distance_is_estimate is bool) &&
        (!('delivery_fee' in request.resource.data) || (request.resource.data.delivery_fee is number && request.resource.data.delivery_fee >= 0 && request.resource.data.delivery_fee <= 1000000));
    }

    // Loyalty members: identified by phone number (used as the doc ID).
    // This app has no per-customer Firebase Auth login - a customer's own
    // browser needs to read/write its OWN member doc without being signed
    // in, so full admin-only lock-down isn't possible here.
    //
    // SECURITY: `get` (look up ONE specific phone number you already know)
    // is allowed, but `list` (query/enumerate the WHOLE collection) is
    // explicitly denied. This is the key fix - without this split, an
    // open collection-level read lets anyone download every registered
    // customer's name and phone number in a single request, with no need
    // to guess anything. Requiring the exact phone number up front is a
    // meaningfully narrower exposure (someone would have to already know
    // or brute-force individual numbers), even though it's not perfect
    // without a real per-customer authentication system.
    match /lighture_members/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null || (
        request.resource.data.points == 0 &&
        request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 20 &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.pin_hash is string && request.resource.data.pin_hash.size() == 64
      );
      allow update: if request.auth != null || (
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.pin_hash == resource.data.pin_hash &&
        request.resource.data.points is number &&
        request.resource.data.points >= 0 &&
        resource.data.points - request.resource.data.points == 70
      );
      allow delete: if request.auth != null;

      // Vouchers now live UNDER their owning member (subcollection) instead
      // of one flat top-level collection. This means a voucher can only be
      // listed/read by someone who already knows that specific phone
      // number's path - there is no single query anywhere that returns
      // every customer's phone number via their vouchers anymore.
      match /vouchers/{voucherId} {
        allow get, list: if true;
        allow create: if request.auth != null || (
          request.resource.data.used == false &&
          request.resource.data.code == 'YEY5RB' &&
          request.resource.data.discount == 5000 &&
          request.resource.data.owner_phone == phone &&
          get(/databases/$(database)/documents/lighture_members/$(phone)).data.points >= 70
        );
        allow update: if request.auth != null || (
          resource.data.used == false &&
          request.resource.data.used == true &&
          request.resource.data.owner_phone == resource.data.owner_phone &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.discount == resource.data.discount
        );
        allow delete: if request.auth != null;
      }
    }
  }
}
